{
  "name": "nexus-fleet",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "docker compose up",
    "db:migrate": "npm run db:migrate -w packages/backend",
    "db:seed": "npm run db:seed -w packages/backend",
    "db:generate": "npm run db:generate -w packages/backend",
    "test": "npm run test -w packages/backend && npm run test -w packages/frontend",
    "test:backend": "npm run test -w packages/backend",
    "test:frontend": "npm run test -w packages/frontend",
    "generate-keys": "bash scripts/generate-keys.sh"
  }
}
